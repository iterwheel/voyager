# Wukong Countdown merge-loop environment template.
#
# Copy to /Users/frank/.voyager/merge-loop.env, edit locally, chmod 600.
# launchd sources it before running vyg countdown merge-loop.

PYTHONUNBUFFERED=1

# Fail closed by default. Set to true only after the VOY-1839 dry-run gate passes.
MERGE_LOOP_ENABLED=false
MERGE_MAX_MERGES=3

# Adaptive cadence (seconds); wrapper validates integers and falls back loudly.
MERGE_FAST_INTERVAL=300
MERGE_SLOW_INTERVAL=3600
MERGE_FAST_STREAK_MAX=6

# Optional: operator-local allowlist extension (merge ceiling — VOY-1839).
# Repos named here are authorized for merging without appearing in the
# source-tree allowlist; they also need a line in the --repos file.
# Malformed entries fail closed. Keep private repo names in this local file
# only.
#
# This file is SOURCED BY THE SHELL (launchd plist): use the comma-separated
# form for multiple repos — an unquoted space would be parsed as
# "assignment followed by a command" and break the job. If you prefer
# whitespace separators, the value must be quoted:
#   VOYAGER_MERGE_EXTRA_REPOS=owner/a,owner/b        # safe unquoted
#   VOYAGER_MERGE_EXTRA_REPOS="owner/a owner/b"      # quoted whitespace
VOYAGER_MERGE_EXTRA_REPOS=
