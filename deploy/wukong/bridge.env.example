# Wukong Voyager bridge environment template.
#
# Copy to /Users/frank/.voyager/bridge.env, edit locally, and chmod 600.
# Do not commit the real file. launchd sources it before starting uvicorn.

PYTHONUNBUFFERED=1
VOYAGER_CONFIG_PATH=/Users/frank/.voyager/config.toml

# Production writes are enabled only when dry-run is explicitly false and the
# target repository is allow-listed. Keep the global fallback unset unless a
# future route intentionally depends on it.
DRY_RUN=false
# BRIDGE_ALLOWED_REPOSITORIES=

# Current Wukong canary scope from issue #44. Do not add more repositories here
# until the staged expansion checklist is approved.
BRIDGE_ALLOWED_REPOSITORIES_ITERWHEEL_BLUEPRINT=frankyxhl/alfred,frankyxhl/trinity,iterwheel/voyager
BRIDGE_ALLOWED_REPOSITORIES_ITERWHEEL_STACK=frankyxhl/alfred,frankyxhl/trinity,iterwheel/voyager
BRIDGE_ALLOWED_REPOSITORIES_ITERWHEEL_CLEARANCE=iterwheel/voyager
BRIDGE_ALLOWED_REPOSITORIES_ITERWHEEL_CHANGELOG=iterwheel/voyager
# Branch cleanup uses a cleanup-specific route slug. Do not allow-list
# iterwheel-assembly here; that would also enable /assembly implementation routes.
BRIDGE_ALLOWED_REPOSITORIES_ITERWHEEL_CLEANUP=iterwheel/voyager
# CI-failure sweep also uses a feature-specific allow-list slug while
# authenticating writes with BRIDGE_CI_FAILING_APP_SLUG below.
BRIDGE_ALLOWED_REPOSITORIES_ITERWHEEL_CI_FAILING=iterwheel/voyager
# Countdown event-driven trigger (CHG-1841): repositories whose Clearance
# RESOLVED-verdict replies may touch the scheduler trigger file. Keep this in
# sync with the Clearance allow-list above — the trigger only fires where
# Clearance posts verdicts. Without this entry the server gate default-denies
# in production (DRY_RUN=false) and the trigger path silently never fires.
BRIDGE_ALLOWED_REPOSITORIES_ITERWHEEL_COUNTDOWN=iterwheel/voyager

# Clearance author wake-up and its review-fix fallback are separate default-off
# controls. The first VOY-1814 canary sets only the exact sandbox repository and
# keeps AUTO_REVIEW_FIX=false until notification delivery is proven end to end.
CLEARANCE_AUTHOR_WAKEUP_ENABLED=false
CLEARANCE_AUTHOR_WAKEUP_AUTO_REVIEW_FIX=false
# CLEARANCE_AUTHOR_WAKEUP_ALLOWED_REPOSITORIES=
# CLEARANCE_AUTHOR_WAKEUP_PFC_DOOR_URL=http://localhost:8420/api/agent-send
# CLEARANCE_AUTHOR_WAKEUP_RECONCILE_INTERVAL_SECONDS=60
# CLEARANCE_AUTHOR_WAKEUP_NOTIFY_AFTER_MINUTES=10
# CLEARANCE_AUTHOR_WAKEUP_FALLBACK_AFTER_MINUTES=20
# CLEARANCE_AUTHOR_WAKEUP_RECEIPT_POLL_INTERVAL_SECONDS=2
# CLEARANCE_AUTHOR_WAKEUP_RECEIPT_TIMEOUT_SECONDS=90
# CLEARANCE_AUTHOR_WAKEUP_RECEIPT_REPOST_SAFETY_MARGIN_SECONDS=300
# CLEARANCE_AUTHOR_WAKEUP_MAX_SAME_ID_REPOSTS=3
# CLEARANCE_AUTHOR_WAKEUP_MAX_DELIVERY_ATTEMPTS=3
# CLEARANCE_AUTHOR_WAKEUP_REQUIRED_SEND_ID_RETENTION_SECONDS=86400
# CLEARANCE_AUTHOR_WAKEUP_AUDIT_DIR=/Users/frank/.voyager/state/clearance-author-wakeup

# Scheduled deployed-version drift alert. Wukong checks the latest release tag
# against its public /healthz version hourly and creates an issue on drift.
BRIDGE_DRIFT_ALERT_ENABLED=true
BRIDGE_DRIFT_ALERT_REPOSITORY=iterwheel/voyager
BRIDGE_DRIFT_ALERT_BRIDGE_URL=https://gh.iterwheel.com
BRIDGE_DRIFT_ALERT_INTERVAL_SECONDS=3600
BRIDGE_DRIFT_ALERT_APP_SLUG=iterwheel-assembly

# Scheduled CI-failure sweep. Wukong checks open PRs daily and marks PRs whose
# latest required checks are failing.
BRIDGE_CI_FAILING_ENABLED=true
BRIDGE_CI_FAILING_REPOSITORY=iterwheel/voyager
BRIDGE_CI_FAILING_INTERVAL_SECONDS=86400
BRIDGE_CI_FAILING_APP_SLUG=iterwheel-assembly

# Assembly verification defaults to Voyager's command set. When Assembly is
# expanded to a non-Voyager repository, use an operator-trusted repo-specific
# override. Commands are split on newlines or `;;`.
# ASSEMBLY_VERIFICATION_COMMANDS_FRANKYXHL__TRINITY="make verify-built;;af validate --root ."

# Repository webhook secret fallback and app-specific webhook secrets. The
# server reads GITHUB_REPOSITORY_WEBHOOK_SECRET for repository-level webhooks.
# Use the exact values from the GitHub webhook/App settings.
GITHUB_REPOSITORY_WEBHOOK_SECRET=replace-with-repository-webhook-secret
GITHUB_WEBHOOK_SECRET_ITERWHEEL_BLUEPRINT=replace-with-blueprint-webhook-secret
GITHUB_WEBHOOK_SECRET_ITERWHEEL_STACK=replace-with-stack-webhook-secret
GITHUB_WEBHOOK_SECRET_ITERWHEEL_CLEARANCE=replace-with-clearance-webhook-secret

# Optional Clearance investigator key. Leave unset if Clearance should not call
# the external investigator in this deployment.
# VOYAGER_DEEPSEEK_API_KEY=replace-with-deepseek-api-key

# Optional local test-bot bypass for canary repositories. Keep unset in normal
# production unless an operator is running a controlled test.
# VOYAGER_TEST_BOT_LOGINS=chatgpt-codex-connector[bot]

# Countdown event-driven trigger file (CHG-1841). The bridge touches this
# file on a Clearance RESOLVED-verdict reply; countdown-resolve-loop.env's
# COUNTDOWN_TRIGGER_PATH is read by the adaptive scheduler on the other side.
# Both default to /Users/frank/.voyager/countdown-resolve-loop.trigger and
# don't need to be set here — only uncomment if you override the default,
# and if you do, set the SAME value in both files or the bridge and
# scheduler silently split into producer/consumer of different files.
# COUNTDOWN_TRIGGER_PATH=/Users/frank/.voyager/countdown-resolve-loop.trigger
